import html, os, re
ROOT = os.path.expanduser("~/src/agent-evolution")
src = os.path.join(ROOT, "docs", "practice.md")
text = open(src).read()
def md(t):
    out, in_p = [], False
    for raw in t.split("\n"):
        l = raw.rstrip()
        if l.startswith("## "):
            if in_p: out.append("</p>"); in_p = False
            out.append('<h2 id="%s">%s</h2>' % (
                re.sub(r"[^a-z0-9]+", "-", l[3:].lower()).strip("-"),
                html.escape(l[3:])))
        elif l.startswith("# "):
            if in_p: out.append("</p>"); in_p = False
            out.append("<h1>%s</h1>" % html.escape(l[2:]))
        elif not l.strip():
            if in_p: out.append("</p>"); in_p = False
        else:
            if not in_p: out.append("<p>"); in_p = True
            out.append(html.escape(l))
    if in_p: out.append("</p>")
    return "\n".join(out)
navs = [(re.sub(r"[^a-z0-9]+","-",m.lower()).strip("-"), m)
        for m in re.findall(r"^## (.+)$", text, re.M)]
page = """<!doctype html><html><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Agent evolution</title><style>
:root{color-scheme:light dark;--fg:#1b1b1b;--muted:#666;--line:#ddd}
@media (prefers-color-scheme:dark){:root{--fg:#e6e6e6;--muted:#9a9a9a;--line:#333}}
body{font:16px/1.62 system-ui,sans-serif;color:var(--fg);background:Canvas;
max-width:44rem;margin:3rem auto;padding:0 1.1rem}
h1{font-size:26px} h2{font-size:19px;margin-top:2.4rem;
border-top:1px solid var(--line);padding-top:1.2rem}
nav{margin:1.4rem 0 2rem;color:var(--muted);font-size:14.5px}
nav a{color:inherit;margin-right:1rem;white-space:nowrap}
p{margin:.85rem 0} a{color:inherit}
footer{margin-top:3rem;color:var(--muted);font-size:13.5px;
border-top:1px solid var(--line);padding-top:1rem}
</style></head><body>
%s
<footer>The human-readable representation of <code>./docs</code>, generated
from it. The docs win.</footer></body></html>""" % md(text).replace(
    "</h1>", "</h1>\n<nav>" + " ".join(
        '<a href="#%s">%s</a>' % (a, html.escape(b)) for a, b in navs) + "</nav>", 1)
open(os.path.join(ROOT, "index.html"), "w").write(page)
print("index.html", len(page), "bytes,", len(navs), "sections")
