#!/usr/bin/env python3
"""Validate a population. Fails; does not warn.

  check-tree [project-dir]

Checks, in order of how badly they break the record:
  1. every agent has a spec, an implementation and node.json
  2. every declared parent resolves
  3. no cycles in the parent graph
  4. no agent imports another agent
  5. every scored agent still hashes to its frozen hash
"""
import os
import re
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import lib  # noqa: E402


def main():
    root, cfg = lib.find_project(sys.argv[1] if len(sys.argv) > 1 else ".")
    nodes = lib.load_population(root, cfg)
    errs = []

    if not nodes:
        errs.append("population %s has no agents" % cfg["population"])

    for rel, n in sorted(nodes.items()):
        if not os.path.exists(os.path.join(n["dir"], "SPEC.md")):
            errs.append("%s: no SPEC.md" % rel)
        elif not n["difference"]:
            errs.append("%s: SPEC.md states no difference from its parents"
                        % rel)
        if not lib.impl_path(n["dir"]):
            errs.append("%s: no implementation (%s)"
                        % (rel, "/".join(lib.IMPL_NAMES)))
        for p in n["parents"]:
            if p not in nodes:
                errs.append("%s: parent %r does not exist" % (rel, p))

    # cycles
    seen, stack = set(), set()

    def walk(rel, chain):
        if rel in stack:
            errs.append("cycle: %s" % " -> ".join(chain + [rel]))
            return
        if rel in seen:
            return
        stack.add(rel)
        for p in nodes.get(rel, {}).get("parents", []):
            if p in nodes:
                walk(p, chain + [rel])
        stack.discard(rel)
        seen.add(rel)

    for rel in nodes:
        walk(rel, [])

    # An agent may import the project api and the standard library, and
    # nothing from another agent. This is a lint, not a sandbox: it reads
    # the entry point only, and cannot see a dynamic import. It resolves
    # against real paths rather than bare names, because an agent slugged
    # "random" would otherwise make every sibling that imports random look
    # like a violation.
    api = os.path.basename(cfg.get("api", "_api"))
    pop_root = os.path.join(root, cfg["population"])
    imp = re.compile(r"^\s*(?:from|import)\s+([A-Za-z_][\w.]*)", re.M)
    for rel, n in sorted(nodes.items()):
        p = lib.impl_path(n["dir"], cfg)
        if not p or not p.endswith(".py"):
            continue
        for mod in imp.findall(open(p).read()):
            top = mod.split(".")[0]
            if top == api:
                continue
            for other, o in nodes.items():
                if other == rel:
                    continue
                if os.path.basename(o["dir"]).replace("-", "_") == top and \
                        os.path.exists(os.path.join(o["dir"], "__init__.py")):
                    errs.append("%s: imports another agent (%s)"
                                % (rel, other))

    # an agent is frozen by its result: the score file records the hash of
    # the code that produced it, and that file is written once
    for rel, n in sorted(nodes.items()):
        was = ((n.get("score") or {}).get("hash")
               or (n.get("frozen") or {}).get("hash"))
        if not was:
            continue
        h = lib.impl_hash(n["dir"], cfg)
        if h != was:
            errs.append("%s: EDITED AFTER IT WAS SCORED - implementation "
                        "hashes to %s, scored with %s. Make a child instead."
                        % (rel, (h or "none")[:12], was[:12]))

    if errs:
        print("check-tree: %d problem(s)" % len(errs))
        for e in errs:
            print("  " + e)
        return 1
    print("check-tree: %d agents, all good" % len(nodes))
    return 0


if __name__ == "__main__":
    sys.exit(main())
