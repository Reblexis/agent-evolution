#!/usr/bin/env python3
"""Render a population as one page: the graph, and what the humans are
asked for. Deterministic, no model in the path, no hand-editing.

  render-tree [project-dir] [-o out.html] [--stdout]

Score files (one per agent, named by its path with / replaced by __) are
whatever the project's runner writes, read for these keys:
  score, lo, hi, board, n, clusters, screen, cost, at
"""
import html
import json
import os
import re
import sys
import time

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import lib  # noqa: E402

WORD = {"champion": "in use", "candidate": "being tested",
        "scored": "measured", "draft": "not run yet", "closed": "closed"}

#: Score is the colour, on one hue from pale to dark. One hue rather than a
#: rainbow because score is a magnitude: the reader should be able to rank
#: two nodes by looking at them, and a rainbow only tells you they differ.
#: Darkest is best, whichever direction "best" runs in for the project.
RAMP = ["#dce8f5", "#b2ccea", "#7ea9d8", "#4e83c0", "#2b5f9e", "#173f70"]
NOSCORE = "#c9c9c9"

#: Cost is the area. sqrt so that twice the area means twice the money,
#: which is what the eye reads, and a floor so a free agent is still a dot.
R_MIN, R_MAX = 4.5, 13.0


def ramp_colour(val, lo, hi, lower_is_better):
    if val is None or hi is None or hi <= lo:
        return NOSCORE if val is None else RAMP[-1]
    t = (val - lo) / float(hi - lo)
    if lower_is_better:
        t = 1.0 - t
    return RAMP[max(0, min(len(RAMP) - 1, int(t * (len(RAMP) - 1) + 0.5)))]


def radius(cost, worst):
    if not cost or not worst:
        return R_MIN
    return R_MIN + (R_MAX - R_MIN) * (float(cost) / worst) ** 0.5


def status_of(n):
    """An agent that has a score is measured, whatever its file says.

    Nothing writes status back after a run, so reading it raw showed five
    scored agents as "not run yet".
    """
    st = n.get("status") or "draft"
    if st == "draft" and n.get("score"):
        return "scored"
    return st


def esc(s):
    return html.escape(str(s if s is not None else ""), quote=True)


def layout(nodes):
    """Column by depth from a root, row by depth-first order. Deterministic."""
    depth = {}

    def d(rel, seen=()):
        if rel in depth:
            return depth[rel]
        if rel in seen:
            return 0
        ps = [p for p in nodes[rel]["parents"] if p in nodes]
        depth[rel] = 0 if not ps else 1 + max(d(p, seen + (rel,)) for p in ps)
        return depth[rel]

    for rel in nodes:
        d(rel)
    kids = {rel: [] for rel in nodes}
    roots = []
    for rel, n in nodes.items():
        prim = n["parents"][0] if n["parents"] and n["parents"][0] in nodes \
            else None
        (kids[prim] if prim else roots).append(rel)
    for k in kids:
        kids[k].sort()
    roots.sort()
    order, seen = [], set()

    def walk(rel):
        if rel in seen:
            return
        seen.add(rel)
        order.append(rel)
        for c in kids[rel]:
            walk(c)

    for r in roots:
        walk(r)
    for rel in sorted(nodes):
        walk(rel)
    return depth, {rel: i for i, rel in enumerate(order)}


def render(root, cfg, nodes, asks):
    metric = cfg.get("metric", {})
    lower = metric.get("lowerIsBetter", True)
    depth, row = layout(nodes)

    # One board, or the picture lies. Scores do not transfer between boards
    # - a board whose typical task sits at 0.25 produces different numbers
    # from one at 0.33 - so colouring each agent by whichever board it
    # happened to run on last puts two different exams on one scale. The
    # reference board is the one the most agents have a score on, newest
    # breaking ties, and an agent that never ran on it is shown as unscored
    # however many other boards it has.
    tally = {}
    for n in nodes.values():
        for h in (n.get("history") or []):
            if h.get("board"):
                tally[h["board"]] = tally.get(h["board"], 0) + 1
    # Prefer a board whose scores are outcomes over one whose scores are a
    # screen, however many more agents the screen board has. A screen
    # measures distance from a price and the outcome measures whether the
    # agent was right, and those rank differently: on 2026-08-16 a constant
    # scored 30.25 on the screen and 22.75 against outcomes, third from
    # last on one and second of five on the other. Colouring by the screen
    # when outcomes exist would tell the reader the opposite of the truth.
    decided = set()
    for n in nodes.values():
        for h in (n.get("history") or []):
            if h.get("board") and (h.get("scoreIs") or "").startswith("outcome"):
                decided.add(h["board"])
    ref = (max(sorted(tally), key=lambda b: (b in decided, tally[b], b))
           if tally else None)
    for n in nodes.values():
        n["score"] = next((h for h in (n.get("history") or [])
                           if h.get("board") == ref), None)

    vals = [n["score"]["score"] for n in nodes.values()
            if (n.get("score") or {}).get("score") is not None]
    smin, smax = (min(vals), max(vals)) if vals else (None, None)
    costs = [(n.get("score") or {}).get("costPerMarket") or 0
             for n in nodes.values()]
    worst_cost = max(costs) if costs else 0
    LANE, COLW, PADL, PADT = 34, 210, 20, 34
    W = PADL + COLW * (max(depth.values()) + 1) + 120 if nodes else 600
    H = PADT * 2 + LANE * (len(nodes) or 1)
    X = lambda rel: PADL + COLW * depth[rel]
    Y = lambda rel: PADT + LANE * row[rel] + LANE / 2
    svg = ['<svg viewBox="0 0 %d %d" xmlns="http://www.w3.org/2000/svg" '
           'style="width:100%%;height:auto;font:13px system-ui,sans-serif">'
           % (W, H)]
    for rel, n in sorted(nodes.items()):
        op = n.get("operator")
        for i, p in enumerate(n["parents"]):
            if p not in nodes:
                continue
            x1, y1, x2, y2 = X(p) + 7, Y(p), X(rel) - 7, Y(rel)
            dash = ' stroke-dasharray="4 4"' if i else ""
            svg.append('<path d="M %g %g C %g %g, %g %g, %g %g" fill="none" '
                       'stroke="var(--line)" stroke-width="1.6"%s/>'
                       % (x1, y1, x1 + COLW * 0.35, y1,
                          x2 - COLW * 0.35, y2, x2, y2, dash))
            # the move that produced the child, written on the edge that
            # produced it: the graph should say how each agent came to be
            if op and op != "root" and i == 0:
                mx, my = (x1 + x2) / 2.0, (y1 + y2) / 2.0 - 4
                svg.append('<text x="%g" y="%g" fill="var(--muted)" '
                           'font-size="10.5" text-anchor="middle">%s</text>'
                           % (mx, my, esc(op)))
    for rel, n in sorted(nodes.items()):
        st = status_of(n)
        s = n.get("score") or {}
        val = s.get("score")
        c = ramp_colour(val if isinstance(val, (int, float)) else None,
                        smin, smax, lower)
        r = radius(s.get("costPerMarket"), worst_cost)
        lbl = n["name"]
        num = ("%.1f" % val) if isinstance(val, (int, float)) else ""
        lo, hi = s.get("lo"), s.get("hi")
        line = "not scored yet"
        if isinstance(val, (int, float)):
            line = "SCORE %.1f (%s)" % (val, s.get("scoreIs") or "score")
            if isinstance(lo, (int, float)) and isinstance(hi, (int, float)):
                line += " [%.1f, %.1f]" % (lo, hi)
            line += " on %s" % (s.get("board") or "?")
            if s.get("answered") is not None:
                line += ", answered %s of %s" % (s["answered"], s.get("of"))
            bc = (s.get("bestConstant") or {}).get("price")
            if bc is not None:
                line += "\nbest constant on that board: %.1f" % bc
            # Unknown and zero are different claims. An agent whose spend
            # was never measured must not be shown as one that spent
            # nothing, which is what this said before.
            secs = (", %ss in total" % s["seconds"]
                    if s.get("seconds") is not None else "")
            if s.get("costUSD") is None:
                line += "\ncost: not measured%s" % secs
            elif s.get("costPerMarket"):
                line += "\ncost: $%.5f a market%s" % (s["costPerMarket"], secs)
            else:
                line += "\ncost: nothing, it pays for no calls%s" % secs
        tip = "%s\n%s\n%s" % (
            n["name"], n["difference"] or "(no difference stated)", line)
        if n.get("operator") and n["operator"] != "root":
            tip += "\nmade by: %s" % n["operator"]
        ring = ' stroke="var(--muted)" stroke-width="1.4" stroke-dasharray="2 2"' \
            if st == "closed" else ""
        svg.append('<circle cx="%g" cy="%g" r="%g" fill="%s"%s><title>%s'
                   '</title></circle>'
                   % (X(rel), Y(rel), r, c, ring, esc(tip)))
        svg.append('<text x="%g" y="%g" fill="var(--fg)" '
                   'dominant-baseline="middle"><title>%s</title>%s'
                   '<tspan dx="8" fill="var(--muted)" font-weight="700">%s'
                   '</tspan></text>'
                   % (X(rel) + R_MAX + 4, Y(rel), esc(tip), esc(lbl),
                      esc(num)))
    svg.append("</svg>")

    # A question you cannot answer where you are reading it is not really
    # being asked. If the project supplies an answer endpoint, each open
    # ask gets its full text and a box; otherwise they are shown read-only.
    endpoint = cfg.get("answerEndpoint")
    token = cfg.get("answerToken", "")
    open_asks = [a for a in asks if a.get("status", "open") == "open"]
    blocks = []
    for a in open_asks:
        full = ""
        try:
            raw = open(os.path.join(root, cfg.get("asks", "asks"),
                                    a["file"])).read()
            # everything after the header block, which is the context a
            # person needs to answer without opening the repository
            m = re.split(r"\n##\s", raw, maxsplit=1)
            if len(m) > 1:
                full = "## " + m[1]
        except OSError:
            pass
        body = ('<details><summary>the whole question</summary>'
                '<pre class="ask">%s</pre></details>' % esc(full)) if full \
            else ""
        form = ""
        if endpoint:
            form = ('<form class="ans" data-ask="%s"><textarea rows="4" '
                    'placeholder="A sentence is enough. It becomes an agent '
                    'next round, with your words quoted in its record."'
                    '></textarea><button type="submit">send</button>'
                    '<span class="said"></span></form>' % esc(a["file"]))
        blocks.append('<li><b>%s</b>, %s <span class="q">unblocks %s</span>'
                      '%s%s</li>'
                      % (esc(a.get("what", a["file"])), esc(a.get("why", "")),
                         esc(a.get("unblocks", "")), body, form))
    asks_html = "".join(blocks) or "<li>Nothing right now.</li>"
    answer_js = ("" if not endpoint else """
document.querySelectorAll('form.ans').forEach(function(f){
 f.addEventListener('submit',function(e){e.preventDefault();
  var t=f.querySelector('textarea'), s=f.querySelector('.said');
  if(!t.value.trim()){return;} s.textContent=' sending...';
  fetch(%s,{method:'POST',headers:{'Content-Type':'application/json'},
   body:JSON.stringify({ask:f.dataset.ask,answer:t.value,token:%s})})
  .then(function(r){return r.json();})
  .then(function(j){s.textContent=j.ok?' saved. It becomes an agent next round.':(' failed: '+(j.error||'?'));
   if(j.ok){t.disabled=true;}})
  .catch(function(){s.textContent=' failed to reach the box.';});});});
""" % (json.dumps(endpoint), json.dumps(token)))

    # A colour scale nobody explained is decoration. The legend states
    # both encodings and the range they cover on this board.
    if vals:
        best, wor = (smin, smax) if lower else (smax, smin)
        chips = "".join(
            '<span class="chip" style="background:%s"></span>' % c
            for c in (RAMP if lower else list(reversed(RAMP))))
        legend = (
            '<div class="key"><span><b>colour</b> is the score: '
            '<span class="q">worst %.1f</span> %s '
            '<span class="q">best %.1f</span></span>'
            % (wor, chips, best))
        if worst_cost:
            legend += (
                '<span><b>size</b> is what it costs a market: '
                '<svg width="34" height="28" style="vertical-align:middle">'
                '<circle cx="7" cy="14" r="%g" fill="var(--muted)"/>'
                '<circle cx="25" cy="14" r="%g" fill="var(--muted)"/></svg>'
                '<span class="q">free to $%.5f</span></span>'
                % (R_MIN, R_MAX, worst_cost))
        legend += ('<span><span class="dashed"></span> a dashed ring means '
                   'the agent is closed</span></div>')
    else:
        legend = ""

    if ref:
        note_board = ("Every number here is from board <b>%s</b>, the one "
                      "most agents have run on. An agent that has not run on "
                      "it shows as unscored even if it has numbers "
                      "elsewhere, because scores do not carry between "
                      "boards." % esc(ref))
    else:
        note_board = ""

    screen = metric.get("screen")
    note = ("%s, lower is better. " if lower else "%s, higher is better. ") \
        % esc(metric.get("name", "score"))
    if screen:
        note += "The quick check (%s) is only a check that an agent is not " \
                "broken; it never decides anything." % esc(screen)

    return """<!doctype html><html><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>%s</title><style>
:root{color-scheme:light dark;--fg:#1b1b1b;--muted:#666;--line:#ccc;
--card:#fafafa}
@media (prefers-color-scheme:dark){:root{--fg:#e6e6e6;--muted:#9a9a9a;
--line:#3a3a3a;--card:#191919}}
body{font:15.5px/1.5 system-ui,sans-serif;color:var(--fg);background:Canvas;
max-width:1000px;margin:2.5rem auto;padding:0 1rem}
h1{font-size:22px;margin:0 0 .2rem} h2{font-size:17px;margin:2rem 0 .4rem}
.sub{color:var(--muted);margin-bottom:1.2rem}
.box{border:1px solid var(--line);border-radius:12px;background:var(--card);
padding:1rem;overflow-x:auto}
ul{margin:.3rem 0;padding-left:1.2rem} li{margin:.35rem 0}
.q{color:var(--muted)}
details{margin:.5rem 0} summary{cursor:pointer;color:var(--muted);
font-size:13px} pre.ask{white-space:pre-wrap;font-size:12.5px;
background:Canvas;border:1px solid var(--line);border-radius:8px;
padding:.7rem;max-height:22rem;overflow:auto}
form.ans{display:flex;gap:.5rem;align-items:flex-start;margin:.5rem 0 0}
form.ans textarea{flex:1;font:13px/1.5 system-ui,sans-serif;padding:.5rem;
border:1px solid var(--line);border-radius:8px;background:Canvas;
color:var(--fg)} form.ans button{padding:.45rem .9rem;border-radius:8px;
border:1px solid var(--line);background:var(--card);color:var(--fg);
cursor:pointer} .said{color:var(--muted);font-size:12.5px;align-self:center}
.key{display:flex;flex-wrap:wrap;gap:1.4rem;align-items:center;
margin:0 0 .7rem;font-size:13.5px;color:var(--fg)}
.key>span{display:flex;align-items:center;gap:.4rem}
.chip{display:inline-block;width:15px;height:11px;border-radius:2px}
.dashed{display:inline-block;width:13px;height:13px;border-radius:50%%;
border:1.4px dashed var(--muted)}
#tip{position:fixed;pointer-events:none;background:var(--card);
border:1px solid var(--line);border-radius:8px;padding:8px 12px;
font-size:13px;max-width:380px;display:none;z-index:9;white-space:pre-line;
line-height:1.45;box-shadow:0 6px 18px rgba(0,0,0,.28)}
</style></head><body><div id="tip"></div>
<h1>%s</h1>
<div class="sub">%s Updated %s.</div>
<div class="sub">%s</div>
%s
<div class="box">%s</div>
<h2>Waiting on you</h2>
<div class="box"><ul>%s</ul></div>
<script>
%s
(function(){var t=document.getElementById('tip');
document.addEventListener('mousemove',function(e){
 var el=e.target.closest&&e.target.closest('circle,text');
 var ti=el&&el.querySelector&&el.querySelector('title');
 if(ti&&ti.textContent){t.textContent=ti.textContent;t.style.display='block';
  t.style.left=Math.min(e.clientX+14,innerWidth-400)+'px';
  t.style.top=(e.clientY+14)+'px';}else{t.style.display='none';}});
})();
</script></body></html>""" % (
        esc(cfg.get("name", "population")), esc(cfg.get("title")
                                                or cfg.get("name", "")),
        note, time.strftime("%Y-%m-%d %H:%M UTC", time.gmtime()), note_board,
        legend, "".join(svg), asks_html, answer_js)


def main():
    args = sys.argv[1:]
    out = None
    if "-o" in args:
        i = args.index("-o")
        out = args[i + 1]
        del args[i:i + 2]
    to_stdout = "--stdout" in args
    args = [a for a in args if a != "--stdout"]
    root, cfg = lib.find_project(args[0] if args else ".")
    nodes = lib.load_population(root, cfg)
    page = render(root, cfg, nodes, lib.load_asks(root, cfg))
    if to_stdout or not out:
        if to_stdout:
            print(page)
            return 0
        out = os.path.join(root, cfg.get("page", "population.html"))
    with open(out, "w") as f:
        f.write(page)
    print("wrote %s (%d agents, %d bytes)" % (out, len(nodes), len(page)))
    return 0


if __name__ == "__main__":
    sys.exit(main())
